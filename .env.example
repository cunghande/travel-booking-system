# 1. Cấu hình ứng dụng chung
PROJECT_NAME="Travel Booking System"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
# 2. Cấu hình Cơ sở dữ liệu MySQL Local
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=travel_booking
DB_POOL_MIN=2
DB_POOL_MAX=10
# 3. Cấu hình Bảo mật & JWT Token
# Khóa bí mật dùng để ký token (Chuỗi ngẫu nhiên dài và bảo mật)
SECRET_KEY=b9c45e8f2a1d7c3b8e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# 4. Cấu hình CORS (Cho phép Frontend gọi API)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
# 5. Cấu hình APIKEY
GEMINI_API_KEY=""
# 6. Địa chỉ các Microservices 
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://localhost:8001
TOUR_SERVICE_URL=http://localhost:8002
BOOKING_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
