{
  "info": {
    "name": "Travel Booking System API - Live DB",
    "_postman_id": "c7a8d6e1-9123-4f56-b789-0123456789ac",
    "description": "Postman Collection - Test tren database thuc. \nTai khoan san co:\n- Admin: admin@travelbooking.com / Admin@123456\n- Staff: staff@travelbooking.com / Staff@123456\n- Customer1: customer1@example.com / Customer@123456\n- Customer2: customer2@example.com / Customer@123456\n- Customer3: customer3@example.com / Customer@123456",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "admin_access_token", "value": "", "type": "string" },
    { "key": "staff_access_token", "value": "", "type": "string" },
    { "key": "created_tour_id", "value": "", "type": "string" },
    { "key": "created_booking_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Register New Customer",
          "event": [{ "listen": "test", "script": { "exec": ["var d = pm.response.json(); pm.test('Status 201', () => pm.response.to.have.status(201)); if (d.id) pm.collectionVariables.set('created_user_id', d.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"newcustomer@example.com\",\n  \"full_name\": \"Nguyen Van Moi\",\n  \"password\": \"NewPass@123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] }
          }
        },
        {
          "name": "Login Customer1 (Tran Thi Lan)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login OK', () => pm.response.to.have.status(200)); var d = pm.response.json(); if (d.access_token) { pm.collectionVariables.set('access_token', d.access_token); pm.collectionVariables.set('refresh_token', d.refresh_token); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer1@example.com\",\n  \"password\": \"Customer@123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "Login Admin",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Admin login OK', () => pm.response.to.have.status(200)); var d = pm.response.json(); if (d.access_token) { pm.collectionVariables.set('admin_access_token', d.access_token); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@travelbooking.com\",\n  \"password\": \"Admin@123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "Login Staff",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Staff login OK', () => pm.response.to.have.status(200)); var d = pm.response.json(); if (d.access_token) { pm.collectionVariables.set('staff_access_token', d.access_token); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"staff@travelbooking.com\",\n  \"password\": \"Staff@123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","me"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": ["var d = pm.response.json(); if (d.access_token) pm.collectionVariables.set('access_token', d.access_token);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] }
          }
        }
      ]
    },
    {
      "name": "02. Tours (Public - Browse)",
      "item": [
        {
          "name": "List PUBLISHED Tours",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/tours?page=1&page_size=10", "host": ["{{baseUrl}}"], "path": ["api","v1","tours"], "query": [{"key":"page","value":"1"},{"key":"page_size","value":"10"}] }
          }
        },
        {
          "name": "Search Tours by Destination",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/tours?destination=Ha Long&page=1&page_size=10", "host": ["{{baseUrl}}"], "path": ["api","v1","tours"], "query": [{"key":"destination","value":"Ha Long"},{"key":"page","value":"1"},{"key":"page_size","value":"10"}] }
          }
        },
        {
          "name": "Filter Tours by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/tours?category=Bien dao&page=1&page_size=10", "host": ["{{baseUrl}}"], "path": ["api","v1","tours"], "query": [{"key":"category","value":"Bien dao"},{"key":"page","value":"1"},{"key":"page_size","value":"10"}] }
          }
        },
        {
          "name": "Filter Tours by Price Range",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/tours?min_price=2000000&max_price=5000000", "host": ["{{baseUrl}}"], "path": ["api","v1","tours"], "query": [{"key":"min_price","value":"2000000"},{"key":"max_price","value":"5000000"}] }
          }
        },
        {
          "name": "Get Tour Detail (Ha Long - TOUR-HN-001)",
          "event": [{ "listen": "test", "script": { "exec": ["var d = pm.response.json(); if (d.id) pm.collectionVariables.set('created_tour_id', d.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/tours?page=1&page_size=1", "host": ["{{baseUrl}}"], "path": ["api","v1","tours"], "query": [{"key":"page","value":"1"},{"key":"page_size","value":"1"}] }
          }
        }
      ]
    },
    {
      "name": "03. Tours (Staff - Manage)",
      "item": [
        {
          "name": "List All Tours (All Statuses)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/tours/manage?page=1&page_size=20", "host": ["{{baseUrl}}"], "path": ["api","v1","tours","manage"], "query": [{"key":"page","value":"1"},{"key":"page_size","value":"20"}] }
          }
        },
        {
          "name": "Create New Tour (Draft)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Tour created', () => pm.response.to.have.status(201)); var d = pm.response.json(); if (d.id) pm.collectionVariables.set('created_tour_id', d.id); console.log('Tour ID:', d.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tour_code\": \"TOUR-TEST-999\",\n  \"title\": \"Tour Test Can Tho - Mekong Delta 2 Days\",\n  \"description\": \"Explore the Mekong Delta: floating markets, coconut candy making, boat rides.\",\n  \"category\": \"Sinh thai\",\n  \"tags\": [\"mekong\", \"floating market\", \"can tho\"],\n  \"destination\": \"Can Tho, Mekong Delta\",\n  \"base_price_adult\": 1800000,\n  \"base_price_child\": 1080000,\n  \"max_participants\": 30,\n  \"start_date\": \"2027-05-01\",\n  \"end_date\": \"2027-05-02\",\n  \"itineraries\": [\n    {\n      \"day_number\": 1,\n      \"title\": \"Cai Rang Floating Market\",\n      \"activities\": [\n        { \"time\": \"05:00\", \"place_name\": \"Cai Rang Floating Market\", \"latitude\": 10.0167, \"longitude\": 105.7667, \"description\": \"Earliest and largest floating market in Mekong\" },\n        { \"time\": \"09:00\", \"place_name\": \"Coconut Candy Workshop\", \"description\": \"Make traditional Ben Tre coconut candy\" }\n      ]\n    },\n    {\n      \"day_number\": 2,\n      \"title\": \"Boat Ride - Return\",\n      \"activities\": [\n        { \"time\": \"07:00\", \"place_name\": \"Phong Dien Market\", \"description\": \"Small local floating market\" },\n        { \"time\": \"12:00\", \"place_name\": \"Can Tho Bus Station\", \"description\": \"Return to HCMC\" }\n      ]\n    }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/tours", "host": ["{{baseUrl}}"], "path": ["api","v1","tours"] }
          }
        },
        {
          "name": "Publish Tour (DRAFT -> PUBLISHED)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/tours/{{created_tour_id}}/publish", "host": ["{{baseUrl}}"], "path": ["api","v1","tours","{{created_tour_id}}","publish"] }
          }
        },
        {
          "name": "Update Tour",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{staff_access_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Tour Test Can Tho UPDATED - Mekong Delta 2 Days\",\n  \"base_price_adult\": 1900000\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/tours/{{created_tour_id}}", "host": ["{{baseUrl}}"], "path": ["api","v1","tours","{{created_tour_id}}"] }
          }
        },
        {
          "name": "Cancel Tour (Admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/tours/{{created_tour_id}}/cancel", "host": ["{{baseUrl}}"], "path": ["api","v1","tours","{{created_tour_id}}","cancel"] }
          }
        },
        {
          "name": "Delete (Archive) Tour (Admin only)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/tours/{{created_tour_id}}", "host": ["{{baseUrl}}"], "path": ["api","v1","tours","{{created_tour_id}}"] }
          }
        }
      ]
    },
    {
      "name": "04. Bookings (Customer)",
      "item": [
        {
          "name": "Create Booking (Need tour_id - get from Tour list first)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Booking created', () => pm.response.to.have.status(201)); var d = pm.response.json(); if (d.id) pm.collectionVariables.set('created_booking_id', d.id); console.log('Booking ID:', d.id, 'Code:', d.booking_code);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"tour_id\": \"{{created_tour_id}}\",\n  \"num_adults\": 2,\n  \"num_children\": 1,\n  \"contact_name\": \"Tran Thi Lan\",\n  \"contact_email\": \"customer1@example.com\",\n  \"contact_phone\": \"0901234567\",\n  \"special_requests\": \"Sea view room please\",\n  \"passengers\": [\n    { \"full_name\": \"Tran Thi Lan\", \"passenger_type\": \"ADULT\", \"id_card_number\": \"001234567890\" },\n    { \"full_name\": \"Tran Van Nam\", \"passenger_type\": \"ADULT\", \"id_card_number\": \"001234567891\" },\n    { \"full_name\": \"Tran Be An\", \"passenger_type\": \"CHILD\" }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/bookings", "host": ["{{baseUrl}}"], "path": ["api","v1","bookings"] }
          }
        },
        {
          "name": "My Bookings (History)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bookings/my?page=1&page_size=10", "host": ["{{baseUrl}}"], "path": ["api","v1","bookings","my"], "query": [{"key":"page","value":"1"},{"key":"page_size","value":"10"}] }
          }
        },
        {
          "name": "Get Booking Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bookings/{{created_booking_id}}", "host": ["{{baseUrl}}"], "path": ["api","v1","bookings","{{created_booking_id}}"] }
          }
        },
        {
          "name": "Cancel My Booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bookings/{{created_booking_id}}/cancel", "host": ["{{baseUrl}}"], "path": ["api","v1","bookings","{{created_booking_id}}","cancel"] }
          }
        }
      ]
    },
    {
      "name": "05. Bookings (Staff - Admin Manage)",
      "item": [
        {
          "name": "List All Bookings (All users)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bookings?page=1&page_size=20", "host": ["{{baseUrl}}"], "path": ["api","v1","bookings"], "query": [{"key":"page","value":"1"},{"key":"page_size","value":"20"}] }
          }
        },
        {
          "name": "Filter Bookings by Status CONFIRMED",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bookings?status=CONFIRMED&page=1&page_size=20", "host": ["{{baseUrl}}"], "path": ["api","v1","bookings"], "query": [{"key":"status","value":"CONFIRMED"},{"key":"page","value":"1"},{"key":"page_size","value":"20"}] }
          }
        },
        {
          "name": "Filter Bookings by Status PENDING_PAYMENT",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bookings?status=PENDING_PAYMENT&page=1&page_size=20", "host": ["{{baseUrl}}"], "path": ["api","v1","bookings"], "query": [{"key":"status","value":"PENDING_PAYMENT"},{"key":"page","value":"1"},{"key":"page_size","value":"20"}] }
          }
        },
        {
          "name": "Confirm a Booking (PENDING -> CONFIRMED)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/bookings/{{created_booking_id}}/confirm", "host": ["{{baseUrl}}"], "path": ["api","v1","bookings","{{created_booking_id}}","confirm"] }
          }
        }
      ]
    },
    {
      "name": "06. Users (Admin)",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users?page=1&page_size=20", "host": ["{{baseUrl}}"], "path": ["api","v1","users"], "query": [{"key":"page","value":"1"},{"key":"page_size","value":"20"}] }
          }
        }
      ]
    }
  ]
}
